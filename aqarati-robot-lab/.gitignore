# ---------------------------------------------------------------------------
# Aqarati Robot AI Lab - project specific ignore rules
# Only files inside aqarati-robot-lab/ are affected by this file.
# ---------------------------------------------------------------------------

# --- Databases -------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
*.sql
*.mdb
data/processed/*.db
data/processed/*.sqlite3

# --- Images and media ------------------------------------------------------
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.tif
*.heic
*.svg
*.ico
*.mp4
*.mov
*.webm

# --- Raw and imported data -------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/legacy/*
!data/legacy/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/imports/*
!data/imports/.gitkeep
!data/imports/manifest.json

# --- Secrets and credentials ----------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore
id_rsa
id_ed25519
.netrc
credentials*
secrets*
*_secret*
service-account*.json

# --- Logs ------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*

# --- Temporary and cache files --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
node_modules/
dist/
build/
